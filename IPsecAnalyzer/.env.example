[TEMPLATE]
# IPsec Analyzer environment template
# Copy to .env and adjust values: cp .env.example .env

# Database
DB_PASSWORD=securepass123
DB_URL=jdbc:postgresql://postgres:5432/ipsec_db

# JWT Security
JWT_SECRET=change-me-to-a-random-64-char-secret-before-deploying-abcdef0123456789
JWT_EXPIRATION=3600000

# Server
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_IPSEC=DEBUG

# File Upload
MAX_FILE_SIZE=100MB

# Application
APP_ENVIRONMENT=production
APP_NAME=IPsec-Analyzer-NTRO

# Mesh signing (REQUIRED for any real multi-node mesh; the demo default is
# rejected with a loud warning at startup)
MESH_SIGNING_KEY=demo-mesh-key-change-me

# Admin bootstrap: on first boot a random admin password is generated and
# written once to ADMIN_CREDENTIALS_FILE (delete it after first login).
# Set ADMIN_PASSWORD (12+ chars) to choose the password yourself instead.
#ADMIN_PASSWORD=
#ADMIN_CREDENTIALS_FILE=.admin-credentials

# Threat intel: optional NVD API key raises the keyless rate limit
# (https://nvd.nist.gov/developers/request-an-api-key)
#NVD_API_KEY=
